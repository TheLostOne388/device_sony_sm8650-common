#<src>                                                  <mnt_point>  <type>  <mnt_flags> <fs_mgr_flags>
/dev/block/bootdevice/by-name/userdata                          /data        ext4    noatime,nosuid,nodev    wait,check,formattable,encryptable=footer,quota,wrappedkey
/dev/block/by-name/metadata                          /metadata    ext4    noatime,nosuid,nodev    wait,check,formattable  # Add formattable,check to fix mount/format errors in recovery
/dev/block/bootdevice/by-name/misc                              /misc        emmc    defaults                                                 defaults

# Restore original logical partitions with AVB (pre-simplification)
system          /system         ext4    ro,barrier=1,discard    wait,slotselect,avb=vbmeta_system,logical,first_stage_mount,verifyatboot=0
system_ext      /system_ext     ext4    ro,barrier=1,discard    wait,slotselect,avb=vbmeta_system,logical,first_stage_mount
product         /product        ext4    ro,barrier=1,discard    wait,slotselect,avb=vbmeta_system,logical,first_stage_mount
vendor          /vendor         erofs   ro                      wait,slotselect,avb=vbmeta,logical,first_stage_mount
vendor_dlkm     /vendor_dlkm    erofs   ro                      wait,slotselect,avb=vbmeta,logical,first_stage_mount
system_dlkm     /system_dlkm    ext4    ro,barrier=1,discard    wait,slotselect,avb=vbmeta,logical,first_stage_mount
odm             /odm            erofs   ro                      wait,slotselect,avb=vbmeta,logical,first_stage_mount

# Comment out any AVB-related lines to prevent verification hangs
# /dev/block/by-name/recovery /recovery emmc defaults slotselect

# Boot partitions - EXACT pdx234 configuration
/dev/block/by-name/boot                            /boot        emmc    defaults    slotselect,avb=vbmeta,first_stage_mount
/dev/block/by-name/init_boot                       /init_boot   emmc    defaults    slotselect,avb=vbmeta,first_stage_mount
/dev/block/by-name/vendor_boot                     /vendor_boot emmc    defaults    slotselect,avb=vbmeta,first_stage_mount
/dev/block/by-name/dtbo                            /dtbo        emmc    defaults    slotselect,avb=vbmeta,first_stage_mount
/dev/block/by-name/recovery                        /recovery    emmc    defaults    slotselect,avb=vbmeta 